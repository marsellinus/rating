# Copy to local.properties and fill in values. Never commit real keys.
sdk.dir=/path/to/Android/Sdk

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
supabase.url=
# Supabase public anon (publishable) key - NEVER the service_role key.
supabase.anonKey=
# OPTIONAL: Google OAuth Web Client ID (Credential Manager).
# Leave blank for email/password-only login (recommended default).
google.webClientId=
