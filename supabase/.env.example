# RATIG backend — copy to supabase/.env for local development:
#   supabase functions serve --env-file supabase/.env
# Values come from Supabase Studio -> Project Settings -> API.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY (Edge Functions / CI). Never commit the real value and
# NEVER bundle it into the APK — it bypasses all Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
