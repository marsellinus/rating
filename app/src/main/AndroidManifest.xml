<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Worker identification barcode/QR scanner (CameraX + ML Kit). Requested
         only when the examiner opens the scanner, never at app start. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".RatigApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RATIG">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RATIG">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share exported reports (CSV/PDF) without storage permissions. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ratig.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- On-demand WorkManager initialization: RatigApp implements
             Configuration.Provider to inject HiltWorkerFactory, so the default
             startup initializer must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Credential Manager requires the digital asset links / metadata below only
             when using passkeys; Google ID token sign-in needs the OAuth clients
             configured in Google Cloud with this app's SHA-1 (see docs/oauth-setup.md). -->
    </application>
</manifest>
